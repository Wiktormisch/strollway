# Copy to .env next to docker-compose.yml on the server and fill in the values there.
# Secrets are left empty. An empty line means "empty", not "default", so optional
# lines are commented out. Never commit the real file. See docs/DEPLOY.md.

# Django. Generate SECRET_KEY on the server (command in docs/DEPLOY.md).
SECRET_KEY=
# Keep "localhost": the container health check calls Django on localhost.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# One origin in production, so CORS stays empty.
# CORS_ALLOWED_ORIGINS=

# Optional: Gunicorn workers (default 2). Use 1 when the server is low on memory.
# GUNICORN_WORKERS=2

# Cloudflare tunnel token (Zero Trust -> Networks -> Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=

# External services.
ROUTING_PROVIDER=auto
ORS_API_KEY=
POI_PROVIDER=db
WEATHER_PROVIDER=auto

# LLM.
LLM_BACKEND=anthropic
LLM_FALLBACKS=nvidia
LLM_DAILY_LIMIT=300
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional: per-IP limits (defaults in backend/config/settings.py).
# ROUTE_PLANS_RATE=
# TRIP_IDEAS_RATE=
# WRITES_RATE=
# PLACE_SEARCH_RATE=
# BEST_TIME_RATE=
# MAX_WALKS_PER_CLIENT=
